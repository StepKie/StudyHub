@page "/study/{DeckId}"
@implements IAsyncDisposable
@inject IDeckRepository Decks
@inject IJSRuntime Js

<PageTitle>Study</PageTitle>

@if (_loading)
{
  <MudProgressLinear Indeterminate="true" />
}
else if (_deck is null)
{
  <MudAlert Severity="Severity.Warning">Deck not found.</MudAlert>
  <MudButton Href="./" Class="mt-3">Back to decks</MudButton>
}
else if (_queue.Count == 0)
{
  <MudText Typo="Typo.h5" Class="mb-2">All done for now</MudText>
  <MudText Class="mb-4">@_done cards reviewed in @Scope.</MudText>
  <MudStack Row="true" Spacing="2">
    <MudButton Href="./" Variant="Variant.Filled" Color="Color.Primary">Back to decks</MudButton>
    @if (_moreNew > 0)
    {
      <MudButton OnClick="StudyMore" Variant="Variant.Outlined" Color="Color.Primary">Study @_moreNew more new cards</MudButton>
    }
  </MudStack>
}
else
{
  var card = _queue[0];
  <MudText Typo="Typo.caption" Class="mb-1">@Scope</MudText>
  <MudProgressLinear Value="_done" Max="_total" Color="Color.Primary" Class="mb-3" />
  <MudCard Class="mb-4">
    <MudCardContent Class="card-face">
      <div>
        <MudText Typo="Typo.h4">@card.Front</MudText>
        @if (_revealed)
        {
          <MudDivider Class="my-4" />
          <MudText Typo="Typo.h5">@card.Back</MudText>
        }
      </div>
    </MudCardContent>
  </MudCard>

  @if (!_revealed)
  {
    <MudButton FullWidth="true" Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _revealed = true)">Show answer (Space)</MudButton>
  }
  else
  {
    <MudGrid Spacing="2">
      @foreach (var (rating, color) in _buttons)
      {
        <MudItem xs="6" sm="3">
          <MudButton FullWidth="true" Variant="Variant.Filled" Color="color" OnClick="@(() => RateAsync(rating))">
            <span class="d-flex flex-column align-center">
              <span>@((int)rating + 1) · @rating</span>
              <span class="mud-typography-caption">@IntervalFormat.Short(Sm2Scheduler.PreviewInterval(card.State, rating, _today))</span>
            </span>
          </MudButton>
        </MudItem>
      }
    </MudGrid>
  }
}

@code {
  static readonly (Rating Rating, Color Color)[] _buttons =
  [
    (Rating.Again, Color.Error),
    (Rating.Hard, Color.Warning),
    (Rating.Good, Color.Success),
    (Rating.Easy, Color.Info),
  ];

  [Parameter]
  public string DeckId { get; set; } = default!;

  [SupplyParameterFromQuery(Name = "tag")]
  public string? Tag { get; set; }

  readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Now);
  Deck? _deck;
  List<Card> _queue = [];
  bool _loading = true;
  bool _revealed;
  int _total;
  int _done;
  int _newLimit = StudyQueue.DefaultNewCardsPerDay;
  int _moreNew;

  DotNetObjectReference<Study>? _self;

  string Scope => Tag is null ? _deck!.Name : $"{_deck!.Name} · {Tag}";

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      _self = DotNetObjectReference.Create(this);
      await Js.InvokeVoidAsync("studyhubKeys.register", _self);
    }
  }

  [JSInvokable]
  public void OnTap()
  {
    if (_queue.Count > 0 && !_revealed)
    {
      _revealed = true;
      StateHasChanged();
    }
  }

  [JSInvokable]
  public async Task OnKey(string key)
  {
    if (_queue.Count == 0) { return; }

    if (key == " " && !_revealed)
    {
      _revealed = true;
    }
    else if (_revealed && int.TryParse(key, out var number) && number is >= 1 and <= 4)
    {
      await RateAsync((Rating)(number - 1));
    }

    StateHasChanged();
  }

  public async ValueTask DisposeAsync()
  {
    await Js.InvokeVoidAsync("studyhubKeys.unregister");
    _self?.Dispose();
  }

  protected override async Task OnInitializedAsync()
  {
    _deck = await Decks.GetAsync(DeckId);
    if (_deck is not null)
    {
      _queue = StudyQueue.Build(_deck, _today, _newLimit, Tag);
      _total = _queue.Count;
      UpdateMoreNew();
    }

    _loading = false;
  }

  async Task RateAsync(Rating rating)
  {
    var card = _queue[0];
    _queue.RemoveAt(0);
    Sm2Scheduler.Review(card.State, rating, _today);
    _deck!.RecordReview(_today, rating, card.Tag);
    if (rating == Rating.Again)
    {
      _queue.Add(card);
    }
    else
    {
      _done++;
    }

    _revealed = false;
    UpdateMoreNew();
    await Decks.SaveAsync(_deck);
  }

  void StudyMore()
  {
    _newLimit += StudyQueue.DefaultNewCardsPerDay;
    _queue = StudyQueue.Build(_deck!, _today, _newLimit, Tag);
    _total += _queue.Count;
    UpdateMoreNew();
  }

  void UpdateMoreNew() =>
    _moreNew = _queue.Count > 0 ? 0 : StudyQueue.Build(_deck!, _today, _newLimit + StudyQueue.DefaultNewCardsPerDay, Tag).Count;
}
