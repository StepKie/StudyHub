@page "/history"
@inject IDeckRepository Decks

<PageTitle>@L["Nav_History"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@L["Nav_History"]</MudText>

@if (_decks is null)
{
  <MudProgressLinear Indeterminate="true" />
}
else if (_decks.Count == 0)
{
  <MudAlert Severity="Severity.Info">@L["History_NoDecks"]</MudAlert>
}
else
{
  <MudStack Spacing="4">
    @foreach (var deck in _decks)
    {
      var days = Enumerable.Range(0, Days).Select(i => _today.AddDays(-i)).ToList();
      var max = Math.Max(1, days.Max(d => DeckStatistics.ReviewsOn(deck, d)));
      var streak = DeckStatistics.Streak(deck, _today);
      <MudCard>
        <MudCardContent>
          <MudText Typo="Typo.h6">@deck.Name</MudText>
          <MudText Typo="Typo.body2" Class="mb-3">
            @L.Plural("History_Total", deck.History.Sum(d => d.Reviews))@(streak > 0 ? " · " + L.Plural("Home_Streak", streak) : "")
          </MudText>
          <MudStack Spacing="1">
            @foreach (var day in days)
            {
              var reviews = DeckStatistics.ReviewsOn(deck, day);
              var notAgain = reviews == 0 ? "" : " · " + L["History_NotAgain", 100 * (reviews - DeckStatistics.AgainOn(deck, day)) / reviews];
              var sections = DeckStatistics.BySection(deck, day).Where(s => s.Tag is not null).ToList();
              <div>
                <MudText Typo="Typo.caption">@day.ToString("ddd d MMM") — @L.Plural("Home_Reviews", reviews)@notAgain</MudText>
                <MudProgressLinear Value="reviews" Max="max" Color="Color.Primary" />
                @foreach (var (tag, count) in sections)
                {
                  <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@tag: @count</MudText>
                }
              </div>
            }
          </MudStack>
        </MudCardContent>
      </MudCard>
    }
  </MudStack>
}

@code {
  const int Days = 14;

  readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Now);
  IReadOnlyList<Deck>? _decks;

  protected override async Task OnInitializedAsync() => _decks = await Decks.GetAllAsync();
}
