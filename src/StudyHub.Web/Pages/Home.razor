@page "/"
@inject IDeckRepository Decks

<PageTitle>StudyHub</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">@L["Nav_Decks"]</MudText>
<MudStack Spacing="0" Class="mb-4">
  <MudText Typo="Typo.caption"><em>@L["Legend_Due"]</em>: @L["Legend_DueText"]</MudText>
  <MudText Typo="Typo.caption"><em>@L["Legend_New"]</em>: @L["Legend_NewText"]</MudText>
  <MudText Typo="Typo.caption"><em>@L["Legend_Started"]</em>: @L["Legend_StartedText"]</MudText>
  <MudText Typo="Typo.caption"><em>@L["Legend_Reviews"]</em>: @L["Legend_ReviewsText"]</MudText>
</MudStack>

@if (_decks is null)
{
  <MudProgressLinear Indeterminate="true" />
}
else if (_decks.Count == 0)
{
  <MudAlert Severity="Severity.Info" Class="mb-4">@L["Home_NoDecks"]</MudAlert>
  <MudButton Href="import" Variant="Variant.Filled" Color="Color.Primary">@L["Nav_Import"]</MudButton>
}
else
{
  <MudStack Spacing="3">
    @foreach (var deck in _decks)
    {
      var tags = deck.GetTags();
      var streak = DeckStatistics.Streak(deck, _today);
      <MudCard>
        <MudCardContent>
          <MudText Typo="Typo.h6">@deck.Name</MudText>
          <MudText Typo="Typo.body2">@Summary(deck, null)</MudText>
          <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L.Plural("Home_ReviewsToday", DeckStatistics.ReviewsOn(deck, _today))@(streak > 1 ? " · " + L.Plural("Home_Streak", streak) : "")
          </MudText>
          @if (TodaySections(deck) is { Length: > 0 } sections)
          {
            <MudText Typo="Typo.caption">@L["Home_Today", sections]</MudText>
          }
        </MudCardContent>
        <MudCardActions>
          <MudButton Href="@StudyHref(deck, null)" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!StudyQueue.HasWork(deck, _today))">@L["Home_Study"]</MudButton>
          @if (tags.Count > 1)
          {
            <MudButton OnClick="@(() => _expandedId = _expandedId == deck.Id ? null : deck.Id)">
              @L["Home_Sections", tags.Count]
            </MudButton>
          }
          <MudSpacer />
          @if (_confirmDeleteId == deck.Id)
          {
            <MudButton Color="Color.Error" OnClick="@(() => DeleteAsync(deck))">@L["Home_DeleteConfirm"]</MudButton>
            <MudButton OnClick="@(() => _confirmDeleteId = null)">@L["Common_Cancel"]</MudButton>
          }
          else
          {
            <MudIconButton Icon="@Icons.Material.Filled.Delete" title="@L["Home_DeleteDeck"]" OnClick="@(() => _confirmDeleteId = deck.Id)" />
          }
        </MudCardActions>
        @if (_expandedId == deck.Id)
        {
          <MudDivider />
          <MudCardContent>
            <MudStack Spacing="1">
              @foreach (var tag in tags)
              {
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                  <div>
                    <MudText Typo="Typo.body1">@tag</MudText>
                    <MudText Typo="Typo.caption">@Summary(deck, tag)</MudText>
                  </div>
                  <MudButton Href="@StudyHref(deck, tag)" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(!StudyQueue.HasWork(deck, _today, tag))">@L["Home_Study"]</MudButton>
                </MudStack>
              }
            </MudStack>
          </MudCardContent>
        }
      </MudCard>
    }
  </MudStack>
}

@code {
  readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Now);
  IReadOnlyList<Deck>? _decks;
  string? _confirmDeleteId;
  string? _expandedId;

  protected override async Task OnInitializedAsync() => _decks = await Decks.GetAllAsync();

  string Summary(Deck deck, string? tag)
  {
    var scope = tag is null ? deck.Cards : deck.Cards.Where(c => c.Tag == tag).ToList();
    var due = scope.Count(c => !c.State.IsNew && c.State.Due <= _today);
    var unseen = scope.Count(c => c.State.IsNew);

    var parts = new List<string> { L.Plural("Home_Cards", scope.Count), L["Home_Due", due], L["Home_New", unseen] };
    var started = scope.Count(c => c.State.FirstReviewed == _today);
    if (started > 0)
    {
      parts.Add(L["Home_StartedToday", started]);
    }

    var reviewedToday = DeckStatistics.ReviewsOn(deck, _today, tag);
    if (tag is not null && reviewedToday > 0)
    {
      parts.Add(L.Plural("Home_ReviewsToday", reviewedToday));
    }

    if (due == 0 && DeckStatistics.NextDue(deck, tag) is { } next)
    {
      parts.Add(L["Home_NextReview", Relative(next)]);
    }

    return string.Join(" · ", parts);
  }

  string Relative(DateOnly date) => (date.DayNumber - _today.DayNumber) switch
  {
    <= 0 => L["Rel_Today"],
    1 => L["Rel_Tomorrow"],
    var days => L["Rel_InDays", days],
  };

  string TodaySections(Deck deck) => string.Join(", ", deck
    .GetTags()
    .Select(tag => (Tag: tag, Reviews: DeckStatistics.ReviewsOn(deck, _today, tag), Started: deck.Cards.Count(c => c.Tag == tag && c.State.FirstReviewed == _today)))
    .Where(s => s.Reviews > 0 || s.Started > 0)
    .Select(s => $"{s.Tag} ({string.Join(" · ", new[] { s.Started > 0 ? L["Home_Started", s.Started].Value : null, s.Reviews > 0 ? L.Plural("Home_Reviews", s.Reviews).Value : null }.OfType<string>())})"));

  static string StudyHref(Deck deck, string? tag) =>
    tag is null ? $"study/{deck.Id}" : $"study/{deck.Id}?tag={Uri.EscapeDataString(tag)}";

  async Task DeleteAsync(Deck deck)
  {
    await Decks.DeleteAsync(deck.Id);
    _confirmDeleteId = null;
    _decks = await Decks.GetAllAsync();
  }
}
