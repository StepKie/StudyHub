@page "/"
@inject IDeckRepository Decks

<PageTitle>StudyHub</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Decks</MudText>
<MudText Typo="Typo.caption" Class="mb-4">due: studied cards whose review date has come · new: not studied yet · started: first seen today · reviews: every rating you gave today (an Again repeat counts again)</MudText>

@if (_decks is null)
{
  <MudProgressLinear Indeterminate="true" />
}
else if (_decks.Count == 0)
{
  <MudAlert Severity="Severity.Info" Class="mb-4">No decks yet. Import an Anki text export or a CSV to get started.</MudAlert>
  <MudButton Href="import" Variant="Variant.Filled" Color="Color.Primary">Import cards</MudButton>
}
else
{
  <MudStack Spacing="3">
    @foreach (var deck in _decks)
    {
      var tags = deck.GetTags();
      var streak = DeckStatistics.Streak(deck, _today);
      <MudCard>
        <MudCardContent>
          <MudText Typo="Typo.h6">@deck.Name</MudText>
          <MudText Typo="Typo.body2">@Summary(deck, null)</MudText>
          <MudText Typo="Typo.body2" Color="Color.Secondary">
            @DeckStatistics.ReviewsOn(deck, _today) reviews today@(streak > 1 ? $" · {streak}-day streak" : "")
          </MudText>
          @if (TodaySections(deck) is { Length: > 0 } sections)
          {
            <MudText Typo="Typo.caption">Today: @sections</MudText>
          }
        </MudCardContent>
        <MudCardActions>
          <MudButton Href="@StudyHref(deck, null)" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!StudyQueue.HasWork(deck, _today))">Study</MudButton>
          @if (tags.Count > 1)
          {
            <MudButton OnClick="@(() => _expandedId = _expandedId == deck.Id ? null : deck.Id)">
              Sections (@tags.Count)
            </MudButton>
          }
          <MudSpacer />
          @if (_confirmDeleteId == deck.Id)
          {
            <MudButton Color="Color.Error" OnClick="@(() => DeleteAsync(deck))">Delete deck and progress?</MudButton>
            <MudButton OnClick="@(() => _confirmDeleteId = null)">Cancel</MudButton>
          }
          else
          {
            <MudIconButton Icon="@Icons.Material.Filled.Delete" title="Delete deck" OnClick="@(() => _confirmDeleteId = deck.Id)" />
          }
        </MudCardActions>
        @if (_expandedId == deck.Id)
        {
          <MudDivider />
          <MudCardContent>
            <MudStack Spacing="1">
              @foreach (var tag in tags)
              {
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                  <div>
                    <MudText Typo="Typo.body1">@tag</MudText>
                    <MudText Typo="Typo.caption">@Summary(deck, tag)</MudText>
                  </div>
                  <MudButton Href="@StudyHref(deck, tag)" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(!StudyQueue.HasWork(deck, _today, tag))">Study</MudButton>
                </MudStack>
              }
            </MudStack>
          </MudCardContent>
        }
      </MudCard>
    }
  </MudStack>
}

@code {
  readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Now);
  IReadOnlyList<Deck>? _decks;
  string? _confirmDeleteId;
  string? _expandedId;

  protected override async Task OnInitializedAsync() => _decks = await Decks.GetAllAsync();

  string Summary(Deck deck, string? tag)
  {
    var scope = tag is null ? deck.Cards : deck.Cards.Where(c => c.Tag == tag).ToList();
    var due = scope.Count(c => !c.State.IsNew && c.State.Due <= _today);
    var unseen = scope.Count(c => c.State.IsNew);

    var parts = new List<string> { $"{scope.Count} cards", $"{due} due", $"{unseen} new" };
    var started = scope.Count(c => c.State.FirstReviewed == _today);
    if (started > 0)
    {
      parts.Add($"{started} started today");
    }

    var reviewedToday = DeckStatistics.ReviewsOn(deck, _today, tag);
    if (tag is not null && reviewedToday > 0)
    {
      parts.Add($"{reviewedToday} reviews today");
    }

    if (due == 0 && DeckStatistics.NextDue(deck, tag) is { } next)
    {
      parts.Add($"next review {Relative(next)}");
    }

    return string.Join(" · ", parts);
  }

  string Relative(DateOnly date) => (date.DayNumber - _today.DayNumber) switch
  {
    <= 0 => "today",
    1 => "tomorrow",
    var days => $"in {days} days",
  };

  string TodaySections(Deck deck) => string.Join(", ", deck
    .GetTags()
    .Select(tag => (Tag: tag, Reviews: DeckStatistics.ReviewsOn(deck, _today, tag), Started: deck.Cards.Count(c => c.Tag == tag && c.State.FirstReviewed == _today)))
    .Where(s => s.Reviews > 0 || s.Started > 0)
    .Select(s => $"{s.Tag} ({string.Join(" · ", new[] { s.Started > 0 ? $"{s.Started} started" : null, s.Reviews > 0 ? $"{s.Reviews} reviews" : null }.OfType<string>())})"));

  static string StudyHref(Deck deck, string? tag) =>
    tag is null ? $"study/{deck.Id}" : $"study/{deck.Id}?tag={Uri.EscapeDataString(tag)}";

  async Task DeleteAsync(Deck deck)
  {
    await Decks.DeleteAsync(deck.Id);
    _confirmDeleteId = null;
    _decks = await Decks.GetAllAsync();
  }
}
