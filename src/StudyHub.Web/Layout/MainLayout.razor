@inherits LayoutComponentBase
@inject LanguageService Language

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
  <MudAppBar Elevation="1">
    <MudText Typo="Typo.h6">StudyHub</MudText>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Home" Color="Color.Inherit" Href="./" title="@L["Nav_Decks"]" />
    <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Inherit" Href="history" title="@L["Nav_History"]" />
    <MudIconButton Icon="@Icons.Material.Filled.FileUpload" Color="Color.Inherit" Href="import" title="@L["Nav_Import"]" />
    <MudIconButton Icon="@Icons.Material.Filled.Backup" Color="Color.Inherit" Href="backup" title="@L["Nav_Backup"]" />
    <MudButton Color="Color.Inherit" OnClick="@(() => Language.SwitchAsync(Language.Other))" title="@L["App_Language"]">@Language.Other.ToUpperInvariant()</MudButton>
    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                   Color="Color.Inherit"
                   OnClick="@(() => _isDarkMode = !_isDarkMode)" />
  </MudAppBar>
  <MudMainContent>
    <MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
      @Body
    </MudContainer>
  </MudMainContent>
</MudLayout>

@code {
  MudThemeProvider _themeProvider = default!;
  bool _isDarkMode = true;

  static readonly MudTheme _theme = new()
  {
    PaletteLight = new PaletteLight { Primary = "#00897b" },
    PaletteDark = new PaletteDark { Primary = "#26a69a" },
  };

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
      StateHasChanged();
    }
  }
}
